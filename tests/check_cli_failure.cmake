if (MODE STREQUAL "parse")
  execute_process(COMMAND "${CLI}" simplify "x + )" RESULT_VARIABLE result ERROR_VARIABLE output)
  set(expected "parse error at offset 4")
elseif (MODE STREQUAL "flag")
  execute_process(COMMAND "${CLI}" simplify x --target=bad RESULT_VARIABLE result ERROR_VARIABLE output)
  set(expected "invalid optimization target")
else()
  message(FATAL_ERROR "unknown CLI test mode")
endif()
if (result EQUAL 0 OR NOT output MATCHES "${expected}")
  message(FATAL_ERROR "missing CLI diagnostic '${expected}': ${output}")
endif()
